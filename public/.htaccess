# Apache Web Server Yapılandırması - Natro Paylaşımlı Hosting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Otomatik HTTPS Yönlendirmesi (SSL)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Var olan dosya veya dizin ise doğrudan servis et (JS, CSS, Resimler vb.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. SPA (Tek Sayfa Uygulaması) - Bulunamayan tüm istekleri index.html'e yönlendir
  RewriteRule ^ index.html [L]
</IfModule>

# Tarayıcı Önbellekleme (Caching) & Performans
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

# Gzip Sıkıştırma (Hızlı yükleme için)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
